+bool enable_card_feedback_collect = false;
+bool enable_card_feedback_apply = false;
+int card_feedback_cached_plan_depth = 0;
+
+/* Only allow built-in immutable operations in cardinality-affecting clauses. */
+static bool
+safe_function(Oid function)
+{
+	return OidIsValid(function) && function < FirstGenbkiObjectId &&
+		func_volatile(function) == PROVOLATILE_IMMUTABLE;
+}
+
+static bool
+safe_type(Oid type)
+{
+	return OidIsValid(type) && type < FirstGenbkiObjectId &&
+		!type_is_rowtype(type);
+}
+
+/* Clear source positions on a copy so SELECT and EXPLAIN share the same key. */
+static bool
+CardFeedbackNormalizeExpr(Node *node, void *context)
+{
+	Bitmapset *allowed = (Bitmapset *) context;
+
+	if (node == NULL)
+		return false;
+	switch (nodeTag(node))
+	{
+		case T_Var:
+		{
+			Var *var = (Var *) node;
+
+			if (!bms_is_member(var->varno, allowed) || var->varlevelsup != 0 ||
+				var->varattno <= 0 || !safe_type(var->vartype))
+				return true;
+			var->location = -1;
+			return false;
+		}
+		case T_Const:
+		{
+			Const *value = (Const *) node;
+
+			if (!safe_type(value->consttype))
+				return true;
+			value->location = -1;
+			return false;
+		}
+		case T_OpExpr:
+		{
+			OpExpr *op = (OpExpr *) node;
+
+			op->opfuncid = get_opcode(op->opno);
+			if (!safe_function(op->opfuncid))
+				return true;
+			op->location = -1;
+			break;
+		}
+		case T_ScalarArrayOpExpr:
+		{
+			ScalarArrayOpExpr *op = (ScalarArrayOpExpr *) node;
+
+			op->opfuncid = get_opcode(op->opno);
+			if (!safe_function(op->opfuncid))
+				return true;
+			op->location = -1;
+			break;
+		}
+		case T_FuncExpr:
+		{
+			FuncExpr *func = (FuncExpr *) node;
+
+			if (func->funcretset || !safe_function(func->funcid))
+				return true;
+			func->location = -1;
+			break;
+		}
+		case T_RelabelType:
+			((RelabelType *) node)->location = -1;
+			break;
+		case T_ArrayExpr:
+			((ArrayExpr *) node)->location = -1;
+			break;
+		case T_NullTest:
+			((NullTest *) node)->location = -1;
+			break;
+		case T_BooleanTest:
+			((BooleanTest *) node)->location = -1;
+			break;
+		case T_BoolExpr:
+			((BoolExpr *) node)->location = -1;
+			break;
+		case T_RangeTblRef:
+			return !bms_is_member(((RangeTblRef *) node)->rtindex, allowed);
+		case T_FromExpr:
+		{
+			FromExpr *from = (FromExpr *) node;
+			ListCell *lc;
+
+			foreach(lc, from->fromlist)
+				if (CardFeedbackNormalizeExpr(lfirst(lc), allowed))
+					return true;
+			return CardFeedbackNormalizeExpr(from->quals, allowed);
+		}
+		case T_JoinExpr:
+		{
+			JoinExpr *join = (JoinExpr *) node;
+
+			return join->jointype != JOIN_INNER ||
+				CardFeedbackNormalizeExpr(join->larg, allowed) ||
+				CardFeedbackNormalizeExpr(join->rarg, allowed) ||
+				CardFeedbackNormalizeExpr(join->quals, allowed);
+		}
+		case T_List:
+			break;
+		default:
+			return true;
+	}
+	return expression_tree_walker(node, CardFeedbackNormalizeExpr, context);
+}
+
+/*
+ * In an MVCC snapshot with xmin == xmax, all older XIDs have finished and
+ * all newer ones are invisible. The full xmax thus identifies the visible
+ * data across backends. With in-flight writers, keep the old transaction
+ * scope (the repeatable-read snapshot stays fixed).
+ */
+static void
+append_snapshot_scope(StringInfo key)
+{
+	Snapshot snapshot = ActiveSnapshotSet() ? GetActiveSnapshot() : NULL;
+
+	if (snapshot != NULL && snapshot->snapshot_type == SNAPSHOT_MVCC &&
+		snapshot->xmin == snapshot->xmax && !snapshot->takenDuringRecovery &&
+		TransactionIdIsNormal(snapshot->xmax))
+	{
+		FullTransactionId next = ReadNextFullTransactionId();
+		uint32 epoch = EpochFromFullTransactionId(next);
+
+		if (snapshot->xmax > XidFromFullTransactionId(next))
+			epoch--;
+		appendStringInfo(key, "shared:%u:%u:", epoch, snapshot->xmax);
+	}
+	else
+		appendStringInfo(key, "local:%d:%lld:%u:", MyProcPid,
+						 (long long) MyStartTimestamp, MyProc->lxid);
+}
+
+/* Freeze the whole supported query context before join search changes paths. */
+static char *
+CardFeedbackReadonlyContext(PlannerInfo *root)
+{
+	Query *query = root->parse;
+	StringInfoData key;
+	ListCell *lc;
+	Bitmapset *allowed = NULL;
+	int rti = 0;
+	Node *jointree;
+	char *serialized;
+
+	if (root->feedback_reuse_checked)
+		return root->feedback_reuse_context;
+	root->feedback_reuse_checked = true;
+	if (!XactReadOnly || XactIsoLevel != XACT_REPEATABLE_READ ||
+		!IsTransactionBlock() || TransactionIdIsValid(GetTopTransactionIdIfAny()) ||
+		card_feedback_cached_plan_depth != 0 || root->glob->boundParams != NULL ||
+		max_parallel_workers_per_gather != 0 || root->parent_root != NULL ||
+		query->commandType != CMD_SELECT ||
+		query->hasWindowFuncs || query->hasTargetSRFs ||
+		query->hasSubLinks || query->hasModifyingCTE || query->hasRowSecurity ||
+		query->cteList != NIL || query->groupingSets != NIL ||
+		query->havingQual != NULL || query->limitCount != NULL ||
+		query->limitOffset != NULL || query->rowMarks != NIL ||
+		query->setOperations != NULL)
+		return NULL;
+	initStringInfo(&key);
+	append_snapshot_scope(&key);
+	foreach(lc, query->rtable)
+	{
+		RangeTblEntry *rte = lfirst_node(RangeTblEntry, lc);
+		Relation relation;
+
+		rti++;
+		if (rte->rtekind == RTE_JOIN && rte->jointype == JOIN_INNER)
+			continue;
+		if (rte->rtekind != RTE_RELATION || rte->relkind != RELKIND_RELATION ||
+			rte->tablesample != NULL || rte->securityQuals != NIL ||
+			rte->relid < FirstNormalObjectId || has_subclass(rte->relid) ||
+			get_rel_persistence(rte->relid) != RELPERSISTENCE_PERMANENT)
+		{
+			pfree(key.data);
+			return NULL;
+		}
+		/* Rewrites and TRUNCATE can change storage even for an old snapshot. */
+		relation = RelationIdGetRelation(rte->relid);
+		if (!RelationIsValid(relation) || relation->rd_rel->relam != HEAP_TABLE_AM_OID)
+		{
+			if (RelationIsValid(relation))
+				RelationClose(relation);
+			pfree(key.data);
+			return NULL;
+		}
+		allowed = bms_add_member(allowed, rti);
+		appendStringInfo(&key, "table:%d:%u:%u:%u;", rti, rte->relid,
+						 relation->rd_locator.spcOid, relation->rd_locator.relNumber);
+		RelationClose(relation);
+	}
+	if (bms_is_empty(allowed))
+	{
+		pfree(key.data);
+		return NULL;
+	}
+	/* Projection, grouping and sorting do not change input relation counts. */
+	jointree = (Node *) copyObject(query->jointree);
+	if (CardFeedbackNormalizeExpr(jointree, allowed))
+	{
+		pfree(key.data);
+		return NULL;
+	}
+	serialized = nodeToString(jointree);
+	appendStringInfo(&key, "tree:%s;", serialized);
+	pfree(serialized);
+	if (key.len >= CARD_FEEDBACK_IDENTITY_BYTES)
+	{
+		pfree(key.data);
+		return NULL;
+	}
+	root->feedback_reuse_relids = allowed;
+	root->feedback_reuse_context = key.data;
+	return key.data;
+}
+
+static char *
+CardFeedbackReadonlyIdentity(PlannerInfo *root, RelOptInfo *rel)
+{
+	const char *context = CardFeedbackReadonlyContext(root);
+	StringInfoData key;
+	int member = -1;
+
+	if (context == NULL || bms_is_empty(rel->relids) ||
+		!bms_is_subset(rel->relids, root->feedback_reuse_relids) ||
+		(rel->reloptkind != RELOPT_BASEREL && rel->reloptkind != RELOPT_JOINREL))
+		return NULL;
+	initStringInfo(&key);
+	appendStringInfo(&key, "%ssubset:", context);
+	while ((member = bms_next_member(rel->relids, member)) >= 0)
+		appendStringInfo(&key, "%d,", member);
+	if (key.len >= CARD_FEEDBACK_IDENTITY_BYTES)
+	{
+		pfree(key.data);
+		return NULL;
+	}
+	return key.data;
+}
+
+static uint64
+card_feedback_rel_signature(PlannerInfo *root, RelOptInfo *rel)
+{
+	StringInfoData key;
+	int member = -1;
+	uint64 result;
+
+	/* Subquery/outer-join identities need a separate design. */
+	if (root->parent_root != NULL || root->parse->commandType != CMD_SELECT ||
+		root->parse->hasSubLinks || root->parse->hasModifyingCTE ||
+		root->parse->hasRowSecurity || bms_is_empty(rel->relids))
+		return 0;
+	if (root->feedback_context == 0)
+	{
+		char *serialized = nodeToString(root->parse);
+
+		root->feedback_context = hash_bytes_extended((unsigned char *) serialized,
+												 strlen(serialized), 0);
+		pfree(serialized);
+	}
+	initStringInfo(&key);
+	appendStringInfo(&key, "%u:%u:%llu", MyDatabaseId, GetUserId(),
+					 (unsigned long long) root->feedback_context);
+	while ((member = bms_next_member(rel->relids, member)) >= 0)
+	{
+		RangeTblEntry *rte;
+
+		if (member <= 0 || member >= root->simple_rel_array_size)
+		{
+			pfree(key.data);
+			return 0;
+		}
+		rte = planner_rt_fetch(member, root);
+		if (rte->rtekind != RTE_RELATION)
+		{
+			pfree(key.data);
+			return 0;
+		}
+		appendStringInfo(&key, ":%d:%u", member, rte->relid);
+	}
+	result = hash_bytes_extended((unsigned char *) key.data, key.len, 0);
+	pfree(key.data);
+	return result;
+}
+
+/* One planner hook for both base tables and inner joins. */
+void
+CardFeedbackEstimate(PlannerInfo *root, RelOptInfo *rel)
+{
+	double learned_rows;
+
+	if (!enable_card_feedback_collect && !enable_card_feedback_apply)
+		return;
+	rel->raw_est_rows = rel->rows;
+	rel->feedback_identity = CardFeedbackReadonlyIdentity(root, rel);
+	if (rel->feedback_identity == NULL)
+	{
+		if (enable_card_feedback_collect)
+			rel->feedback_sig = card_feedback_rel_signature(root, rel);
+		return;
+	}
+
+	rel->feedback_sig = hash_bytes_extended((unsigned char *) rel->feedback_identity,
+										   strlen(rel->feedback_identity), 0);
+	if (enable_card_feedback_apply &&
+		CardFeedbackLookup(rel->feedback_sig, rel->feedback_identity, &learned_rows))
+	{
+		rel->rows = clamp_row_est(learned_rows);
+		elog(DEBUG1, "card_feedback applied signature=" UINT64_FORMAT " raw=%.0f learned=%.0f",
+			 rel->feedback_sig, rel->raw_est_rows, learned_rows);
+	}
+}
+
+/* Shared observations live until eviction, reset or server restart. */
+static HTAB *CardFeedbackHash = NULL;
+
+Size
+CardFeedbackShmemSize(void)
+{
+	return hash_estimate_size(CARD_FEEDBACK_MAX_ENTRIES, sizeof(CardFeedbackEntry));
+}
+
+void
+CardFeedbackShmemInit(void)
+{
+	HASHCTL ctl;
+
+	MemSet(&ctl, 0, sizeof(ctl));
+	ctl.keysize = sizeof(CardFeedbackKey);
+	ctl.entrysize = sizeof(CardFeedbackEntry);
+	CardFeedbackHash = ShmemInitHash("Cardinality feedback statistics",
+									CARD_FEEDBACK_MAX_ENTRIES,
+									CARD_FEEDBACK_MAX_ENTRIES,
+									&ctl, HASH_ELEM | HASH_BLOBS | HASH_FIXED_SIZE);
+}
+
+void
+CardFeedbackRecord(uint64 signature, double raw_rows, double actual_rows,
+				   const char *identity)
+{
+	CardFeedbackKey key;
+	CardFeedbackEntry *entry;
+	bool found;
+
+	if (signature == 0 || CardFeedbackHash == NULL)
+		return;
+	MemSet(&key, 0, sizeof(key));
+	key.database_id = MyDatabaseId;
+	key.user_id = GetUserId();
+	key.signature = signature;
+	LWLockAcquire(CardFeedbackLock, LW_EXCLUSIVE);
+	entry = hash_search(CardFeedbackHash, &key, HASH_FIND, NULL);
+	if (entry == NULL)
+	{
+		if (hash_get_num_entries(CardFeedbackHash) == CARD_FEEDBACK_MAX_ENTRIES)
+		{
+			HASH_SEQ_STATUS scan;
+			CardFeedbackEntry *candidate;
+			CardFeedbackEntry *oldest = NULL;
+
+			hash_seq_init(&scan, CardFeedbackHash);
+			while ((candidate = hash_seq_search(&scan)) != NULL)
+				if (oldest == NULL || candidate->last_updated < oldest->last_updated)
+					oldest = candidate;
+			hash_search(CardFeedbackHash, &oldest->key, HASH_REMOVE, NULL);
+		}
+		entry = hash_search(CardFeedbackHash, &key, HASH_ENTER_NULL, &found);
+		if (entry != NULL)
+		{
+			entry->identity[0] = '\0';
+			if (identity != NULL)
+				strlcpy(entry->identity, identity, sizeof(entry->identity));
+			entry->observations = 0;
+			entry->ema_actual_rows = actual_rows;
+		}
+	}
+	/* A hash collision must never merge a reusable identity with another entry. */
+	if (entry != NULL &&
+		strcmp(entry->identity, identity != NULL ? identity : "") == 0)
+	{
+		entry->raw_est_rows = raw_rows;
+		entry->last_actual_rows = actual_rows;
+		if (entry->observations > 0)
+			entry->ema_actual_rows = 0.5 * actual_rows + 0.5 * entry->ema_actual_rows;
+		entry->observations++;
+		entry->last_updated = GetCurrentTimestamp();
+	}
+	LWLockRelease(CardFeedbackLock);
+}
+
+CardFeedbackEntry *
+CardFeedbackSnapshot(int *count)
+{
+	CardFeedbackEntry *copy = palloc(sizeof(CardFeedbackEntry) * CARD_FEEDBACK_MAX_ENTRIES);
+	HASH_SEQ_STATUS scan;
+	CardFeedbackEntry *entry;
+
+	*count = 0;
+	LWLockAcquire(CardFeedbackLock, LW_SHARED);
+	hash_seq_init(&scan, CardFeedbackHash);
+	while ((entry = hash_seq_search(&scan)) != NULL)
+	{
+		if (entry->key.database_id == MyDatabaseId && entry->key.user_id == GetUserId())
+			copy[(*count)++] = *entry;
+	}
+	LWLockRelease(CardFeedbackLock);
+	return copy;
+}
+
+int
+CardFeedbackReset(void)
+{
+	CardFeedbackKey *keys;
+	int removed = 0;
+	int i;
+
+	/* One exclusive critical section makes reset atomic relative to writers. */
+	keys = palloc(sizeof(CardFeedbackKey) * CARD_FEEDBACK_MAX_ENTRIES);
+	LWLockAcquire(CardFeedbackLock, LW_EXCLUSIVE);
+	{
+		HASH_SEQ_STATUS scan;
+		CardFeedbackEntry *entry;
+
+		hash_seq_init(&scan, CardFeedbackHash);
+		while ((entry = hash_seq_search(&scan)) != NULL)
+			if (entry->key.database_id == MyDatabaseId && entry->key.user_id == GetUserId())
+				keys[removed++] = entry->key;
+	}
+	for (i = 0; i < removed; i++)
+		hash_search(CardFeedbackHash, &keys[i], HASH_REMOVE, NULL);
+	LWLockRelease(CardFeedbackLock);
+	pfree(keys);
+	return removed;
+}
+
+bool
+CardFeedbackLookup(uint64 signature, const char *identity, double *rows)
+{
+	CardFeedbackKey key;
+	CardFeedbackEntry *entry;
+	bool found = false;
+
+	if (CardFeedbackHash == NULL || identity == NULL || signature == 0)
+		return false;
+	MemSet(&key, 0, sizeof(key));
+	key.database_id = MyDatabaseId;
+	key.user_id = GetUserId();
+	key.signature = signature;
+	LWLockAcquire(CardFeedbackLock, LW_SHARED);
+	entry = hash_search(CardFeedbackHash, &key, HASH_FIND, NULL);
+	if (entry != NULL && entry->observations > 0 &&
+		strcmp(entry->identity, identity) == 0)
+	{
+		*rows = entry->last_actual_rows;
+		found = true;
+	}
+	LWLockRelease(CardFeedbackLock);
+	return found;
+}
+
+/* Restrict candidates to complete output of a small serial plan vocabulary. */
+static bool
+CardFeedbackUnsupported(PlanState *ps, void *context)
+{
+	if (ps == NULL)
+		return false;
+	if (ps->initPlan != NIL || ps->subPlan != NIL || ps->plan->parallel_aware)
+		return true;
+	switch (nodeTag(ps->plan))
+	{
+		case T_SeqScan:
+		case T_IndexScan:
+		case T_IndexOnlyScan:
+		case T_BitmapHeapScan:
+		case T_BitmapIndexScan:
+		case T_BitmapAnd:
+		case T_BitmapOr:
+		case T_Hash:
+		case T_Material:
+		case T_Memoize:
+		case T_Sort:
+		case T_Agg:
+			break;
+		case T_NestLoop:
+		case T_HashJoin:
+		case T_MergeJoin:
+			if (((Join *) ps->plan)->jointype != JOIN_INNER)
+				return true;
+			break;
+		default:
+			return true;
+	}
+	return planstate_tree_walker(ps, CardFeedbackUnsupported, context);
+}
+
+/* Exact statement context, deliberately narrower than cross-query equivalence. */
+static uint64
+CardFeedbackRootKey(QueryDesc *qd)
+{
+	StringInfoData key;
+	ListCell *lc;
+	int start = Max(qd->plannedstmt->stmt_location, 0);
+	int length = qd->plannedstmt->stmt_len;
+	int rti = 0;
+	uint64 result;
+
+	if (length <= 0)
+		length = strlen(qd->sourceText + start);
+	initStringInfo(&key);
+	appendStringInfo(&key, "%u:%u:", MyDatabaseId, GetUserId());
+	appendBinaryStringInfo(&key, qd->sourceText + start, length);
+	foreach(lc, qd->plannedstmt->rtable)
+	{
+		RangeTblEntry *rte = lfirst_node(RangeTblEntry, lc);
+
+		appendStringInfo(&key, ":%d:%d:%u", ++rti, (int) rte->rtekind, rte->relid);
+	}
+	result = hash_bytes_extended((unsigned char *) key.data, key.len, 0);
+
+	pfree(key.data);
+	return result;
+}
+
+/* Descend only along inputs whose complete consumption has been established. */
+static void
+CollectCardFeedbackSubtree(PlanState *ps, bool complete, bool root)
+{
+	Instrumentation *instr;
+
+	if (ps == NULL || !complete)
+		return;
+	instr = ps->instrument;
+	if (instr == NULL)
+		return;
+	InstrEndLoop(instr);
+	if (instr->nloops != 1)
+		return;
+	if ((root || ps->plan->feedback_identity != NULL) &&
+		ps->plan->feedback_sig != 0)
+	{
+		CardFeedbackRecord(ps->plan->feedback_sig, ps->plan->raw_est_rows,
+						   instr->ntuples, ps->plan->feedback_identity);
+		ereport(DEBUG1,
+				(errmsg("card_feedback stored scope=subset signature=%llu actual=%.0f",
+						(unsigned long long) ps->plan->feedback_sig, instr->ntuples)));
+	}
+	switch (nodeTag(ps->plan))
+	{
+		case T_NestLoop:
+			CollectCardFeedbackSubtree(outerPlanState(ps), true, false);
+			/* Inner-unique joins can stop after the first matching tuple. */
+			CollectCardFeedbackSubtree(innerPlanState(ps),
+									  !((NestLoopState *) ps)->js.single_match, false);
+			break;
+		case T_HashJoin:
+		{
+			HashJoinTable table = ((HashJoinState *) ps)->hj_HashTable;
+
+			/* An empty inner table can stop after prefetching one outer tuple. */
+			CollectCardFeedbackSubtree(outerPlanState(ps),
+									  table != NULL && table->totalTuples > 0 && table->nbatch == 1,
+									  false);
+			/* A built serial hash table fully consumes its original input. */
+			CollectCardFeedbackSubtree(innerPlanState(ps), table != NULL, false);
+			break;
+		}
+		case T_Hash:
+		case T_Material:
+		case T_Sort:
+		case T_Agg:
+			CollectCardFeedbackSubtree(outerPlanState(ps), true, false);
+			break;
+		/* Memoize can replay partial inputs. Merge join can stop either input early. */
+		default:
+			break;
+	}
+}
+
+static bool
+ReportCardFeedbackRows(PlanState *ps, void *context)
+{
+	if (ps == NULL)
+		return false;
+	if (ps->instrument != NULL)
+	{
+		Instrumentation *instr = ps->instrument;
+
+		/* Idempotent after EXPLAIN has already finalized the loop. */
+		InstrEndLoop(instr);
+		if (instr->nloops > 0 && ps->plan->feedback_sig != 0)
+			ereport(DEBUG1,
+					(errmsg("card_feedback logical node=%d signature=%llu raw_estimated=%.0f validity=unverified",
+							ps->plan->plan_node_id,
+							(unsigned long long) ps->plan->feedback_sig,
+							ps->plan->raw_est_rows)));
+		if (instr->nloops > 0)
+			ereport(DEBUG1,
+					(errmsg("card_feedback diagnostic node=%d tag=%d estimated=%.0f actual_per_loop=%.0f loops=%.0f total=%.0f validity=unverified",
+							ps->plan->plan_node_id, (int) nodeTag(ps->plan),
+							ps->plan->plan_rows, instr->ntuples / instr->nloops,
+							instr->nloops, instr->ntuples)));
+	}
+	return planstate_tree_walker(ps, ReportCardFeedbackRows, context);
+}
+
+void
+CardFeedbackCollect(QueryDesc *qd)
+{
+	PlanState *root = qd->planstate;
+
+	if (qd->estate->es_card_feedback_exhausted &&
+		!qd->estate->es_card_feedback_unsafe &&
+		!qd->plannedstmt->parallelModeNeeded &&
+		!qd->plannedstmt->hasModifyingCTE &&
+		!qd->plannedstmt->dependsOnRole &&
+		qd->plannedstmt->subplans == NIL && qd->params == NULL &&
+		!CardFeedbackUnsupported(root, NULL))
+	{
+		CollectCardFeedbackSubtree(root, true, true);
+		if (message_level_is_interesting(DEBUG1) && qd->sourceText != NULL &&
+			root->instrument != NULL && root->instrument->nloops == 1)
+			elog(DEBUG1, "card_feedback candidate scope=query_root key=" UINT64_FORMAT
+				 " estimated=%.0f actual=%.0f", CardFeedbackRootKey(qd),
+				 root->plan->plan_rows, root->instrument->ntuples);
+	}
+
+	if (message_level_is_interesting(DEBUG1))
+		ReportCardFeedbackRows(root, NULL);
+}
